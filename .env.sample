PROWLARR_API_KEY=
JELLYFIN_API_KEY=
SEERR_API_KEY=
BAZARR_API_KEY=
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=adminadmin
ADGUARD_USERNAME=admin
ADGUARD_PASSWORD=


# NUT UPS server (scripts/configure-ups.sh) - nasmonitor must match the NAS UPS client settings
NUT_LOCALMONITOR_PASSWORD=
NUT_NASMONITOR_PASSWORD=
