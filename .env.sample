TS_AUTHKEY=
APPDATA_ROOT=/docker/appdata
MEDIA_ROOT=/mnt/external-hdd/data
BESZEL_KEY=
SOCKS5_UPSTREAM_USER=
SOCKS5_UPSTREAM_PASS=
